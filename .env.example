# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Ambas são chaves públicas, protegidas pelo RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Pode ser a "anon key" (legada) ou a "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
